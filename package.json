{
  "name": "node-zpl",
  "type": "module",
  "version": "1.0.5",
  "description": "ZPL generator for TypeScript",
  "types": "build/index.d.ts",
  "module": "build/index.js",
  "main": "build/index.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.js"
    },
    "./image": {
      "types": "./build/image.d.ts",
      "import": "./build/image.js",
      "require": "./build/image.js"
    },
    "./jsx": {
      "types": "./build/jsx.d.ts",
      "import": "./build/jsx.js",
      "require": "./build/jsx.js"
    },
    "./jsx-runtime": {
      "types": "./build/jsx-runtime.d.ts",
      "import": "./build/jsx-runtime.js",
      "require": "./build/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./build/jsx-dev-runtime.d.ts",
      "import": "./build/jsx-dev-runtime.js",
      "require": "./build/jsx-dev-runtime.js"
    }
  },
  "repository": "https://github.com/ludwig-f/node-zpl",
  "license": "MIT",
  "keywords": [
    "zpl",
    "zpl2",
    "label",
    "printer",
    "zebra",
    "typescript",
    "ts",
    "node",
    "nodejs"
  ],
  "scripts": {
    "build": "tsc",
    "fix": "prettier \"src/**/*.{ts,tsx}\" --write",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest",
    "watch": "tsc -w",
    "version": "standard-version",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^6.11.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^2.1.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
    "vitest": "^1.3.1"
  },
  "files": [
    "build",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "jimp": "^0.22.12"
  }
}
