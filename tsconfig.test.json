{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "node-zpl",
    "paths": {
      "node-zpl/jsx-runtime": ["./src/jsx-runtime.ts"],
      "node-zpl/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules/**"]
}
