{
  "name": "node-zpl",
  "type": "module",
  "version": "1.0.5",
  "description": "Build, parse and lint ZPL for Zebra label printers, with typed method calls or JSX",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./image": {
      "types": "./build/image.d.ts",
      "default": "./build/image.js"
    },
    "./jsx": {
      "types": "./build/jsx.d.ts",
      "default": "./build/jsx.js"
    },
    "./jsx-runtime": {
      "types": "./build/jsx-runtime.d.ts",
      "default": "./build/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./build/jsx-dev-runtime.d.ts",
      "default": "./build/jsx-dev-runtime.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludwig-f/node-zpl.git",
    "directory": "packages/zpl"
  },
  "license": "MIT",
  "keywords": [
    "zpl",
    "zpl2",
    "label",
    "printer",
    "zebra",
    "typescript",
    "ts",
    "node",
    "nodejs"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest --run",
    "watch": "tsc -w"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
    "vitest": "^1.3.1"
  },
  "files": [
    "build",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "jimp": "^0.22.12"
  }
}
